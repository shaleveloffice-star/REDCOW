rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public CMS (Client read OK; Client write denied — Admin SDK only) ---
    match /menuItems/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /menuCategories/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /branches/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /orderLinks/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /pressItems/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /siteImageOverrides/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Private (no Client access; Admin SDK only) ---
    match /customerClubSignups/{documentId} {
      allow read, write: if false;
    }

    match /contactMessages/{documentId} {
      allow read, write: if false;
    }

    match /careerApplications/{documentId} {
      allow read, write: if false;
    }

    match /adminUsers/{documentId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
