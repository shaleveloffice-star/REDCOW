# Public site URL (canonical, sitemap, Open Graph, JSON-LD).
# Production: https://nbburger.co.il
NEXT_PUBLIC_APP_URL=https://nbburger.co.il

# -----------------------------------------------------------------------------
# Admin authentication
# -----------------------------------------------------------------------------
# Production recommended: firebase
# Temporary conscious option: password
# Dev-only (blocked when NODE_ENV=production): open | mock
# If unset, defaults to password (never open).
ADMIN_AUTH_MODE=firebase

# Server-only. Min 32 characters. Required in production for all non-open modes.
ADMIN_SESSION_SECRET=

# Comma-separated allowlist. Required in production (and for password/firebase).
ADMIN_ALLOWED_EMAILS=admin@example.com

# Required only when ADMIN_AUTH_MODE=password. Min 12 characters. Never use in
# production long-term — prefer firebase.
ADMIN_DEV_PASSWORD=

# -----------------------------------------------------------------------------
# Firebase Client (public — browser). Required when using Firestore / Firebase Auth.
# Without these, the app uses local/mock stores (dev only — not for production).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Analytics measurement ID (not wired to client SDK yet).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase Admin (server-only). Required for all Firestore writes when Firebase
# Client is configured, and required in production when ADMIN_AUTH_MODE=firebase.
# Never expose to the browser. Paste private key with \n for newlines.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Vercel Blob (server-only). Menu / media image uploads — PUBLIC store only.
# Connected store: nbburger-blob (store_YtiRgyBGU1IPJyak), Access: Public.
# Auto-injected when the public Blob store is connected to the Vercel project.
# On Vercel: BLOB_STORE_ID + VERCEL_OIDC_TOKEN are preferred (avoids private tokens).
# Local: paste BLOB_READ_WRITE_TOKEN from the PUBLIC store (never a private store).
# -----------------------------------------------------------------------------
BLOB_STORE_ID=store_YtiRgyBGU1IPJyak
BLOB_READ_WRITE_TOKEN=
